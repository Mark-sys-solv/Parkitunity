# Copy to .env and fill in. Never commit .env!

# Use built-in dummy data instead of live APIs (true/false)
PARKITUNITY_USE_DUMMY_DATA=true

# SQLite database path (default: data/parkitunity.db)
PARKITUNITY_DB_PATH=data/parkitunity.db

# Optional: routing API key (e.g. OpenRouteService) for real driving times
ROUTING_API_KEY=
