# Copy to .env and fill in. Never commit .env!

# Skip live parking data and use built-in dummy garages (true/false).
# With false, dummy data is only used as a fallback if the API fails.
PARKITUNITY_USE_DUMMY_DATA=false

# SQLite database path (default: data/parkitunity.db)
PARKITUNITY_DB_PATH=data/parkitunity.db

# Routing backend for driving times (currently only: haversine)
PARKITUNITY_ROUTING_PROVIDER=haversine

# Optional: routing API key (e.g. OpenRouteService) for real driving times
ROUTING_API_KEY=
